{
  "name": "@bemedev/interval2-vitest",
  "version": "1.2.0",
  "description": "Vitest test utilities for @bemedev/interval2.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./interval": {
      "types": "./lib/interval.d.ts",
      "import": "./lib/interval.js",
      "require": "./lib/interval.cjs"
    },
    "./timeout": {
      "types": "./lib/timeout.d.ts",
      "import": "./lib/timeout.js",
      "require": "./lib/timeout.cjs"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "package.json",
    "CHANGE_LOG.md"
  ],
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "homepage": "https://github.com/chlbri/interval2/blob/master/packages/interval2-vitest/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/interval2"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "timer",
    "interval",
    "timeout",
    "vitest",
    "testing"
  ],
  "scripts": {
    "build": "pnpm run rm:lib && pnpm run rolldown",
    "rm:lib": "pnpx rimraf ./lib",
    "test": "exit 0",
    "fmt": "oxfmt",
    "lint": "oxlint --fix && pnpm run fmt",
    "pretest": "pnpm run build && pnpm run size",
    "posttest": "exit 0",
    "test:only": "pnpm run test --no-coverage",
    "_ci": "pnpm run lint && pnpm run test",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "dependencies": {
    "@bemedev/interval2": "workspace:^"
  },
  "peerDependencies": {
    "vitest": ">=4.1.10"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.1.1",
    "rolldown": "^1.2.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "size-limit": [
    {
      "path": "lib/**/*.js",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.d.ts",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.cjs",
      "limit": "10 kb"
    }
  ]
}
